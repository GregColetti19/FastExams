# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — NEVER put real secrets in this .example file (it is committed).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # server-side only — bypasses RLS

# Anthropic (default chat provider)
ANTHROPIC_API_KEY=your-anthropic-key

# OpenAI (embeddings — default provider)
OPENAI_API_KEY=your-openai-key

# --- Embedding provider/model (optional; default = OpenAI text-embedding-3-small
#     @ 1536 dims via OPENAI_API_KEY). Point EMBED_BASE_URL at OpenRouter to use
#     the already-present OPEN_ROUTER_API_KEY. Changing the MODEL/DIM needs a
#     migration + full re-embed — see supabase/migrations/011_embedding_provenance.sql ---
# EMBED_BASE_URL=https://openrouter.ai/api/v1  # default https://api.openai.com/v1
# EMBED_API_KEY=your-key                        # falls back to OPEN_ROUTER_API_KEY, then OPENAI_API_KEY
# EMBED_MODEL_ID=text-embedding-3-small
# EMBED_DIMENSIONS=1536                          # only set to request MRL dim truncation
# EMBED_BATCH=96                                 # model-dependent
# EMBED_MAX_INPUT_CHARS=8000                     # model-dependent (context limit)

# --- Chat provider (optional; default = anthropic, uses ANTHROPIC_API_KEY) ---
# Set AI_PROVIDER=openai-compat to route ALL chat tasks through an OpenAI-shaped
# API (OpenRouter, DeepInfra, etc.) with zero call-site changes. This is what
# activates use of the already-present OPEN_ROUTER_API_KEY below.
# AI_PROVIDER=openai-compat
# AI_BASE_URL=https://openrouter.ai/api/v1   # default when provider=openai-compat and unset
# AI_API_KEY=your-key                         # falls back to OPEN_ROUTER_API_KEY
# OPEN_ROUTER_API_KEY=sk-or-...               # single key serves chat + embeddings
# AI_HTTP_REFERER=https://your-app            # optional OpenRouter attribution header
# AI_APP_TITLE=FastExams                      # optional OpenRouter attribution (X-Title)

# --- Per-task model overrides (optional; all default to AI_MODEL_DEFAULT, then
#     to the built-in claude-sonnet-4-6). Set one to change only that task. ---
# AI_MODEL_DEFAULT=anthropic/claude-sonnet-4.6
# AI_MODEL_TOPIC_HIERARCHY=...
# AI_MODEL_TOPIC_EXTRACTION=...
# AI_MODEL_TIEBREAK=...
# AI_MODEL_QUESTION_GEN=...
# AI_MODEL_FLASHCARD_GEN=...
# AI_MODEL_PAST_EXAM_EXTRACTION=...
# AI_MODEL_ANSWER_DETERMINATION=...
# AI_MODEL_JUSTIFICATION=...

# Shared secret for internal server-to-server API calls (upload → process-file,
# generate-exam → generate-questions/recalibrate). Those run detached after the
# response is sent, so they carry no session cookie and authenticate with this
# header instead. Required whenever DB_MODE is not mock — without it middleware
# rejects them and file processing never starts. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=

# Processing
CONVERTER_SERVICE_URL=http://localhost:8001

# Shared secret for the converter service. Must match CONVERTER_SECRET set on
# the converter itself. Empty locally (the service leaves /convert open when
# unset); required in any deployment — document conversion is expensive CPU work
# and an exposed endpoint is free compute for anyone who finds it.
CONVERTER_SECRET=
# Per-file upload cap. 50MB is the Supabase FREE-TIER storage limit — set this
# above it and oversized files upload in full, then fail at storage with a 413.
# Raise both together (Supabase bucket setting + this) on a paid tier.
MAX_FILE_SIZE_MB=50
# Same value, exposed to the browser so the upload UI can reject oversized files
# before sending. Keep the two in sync.
NEXT_PUBLIC_MAX_FILE_SIZE_MB=50

# Per-user rolling-24h upload budget in MB. Bounds AI spend: ingestion cost
# scales with document volume, so this caps what one account can spend per day.
# 200MB ≈ 4 uploads at the 50MB cap. Provider-side spend caps remain the real
# backstop — file size only approximates token count.
DAILY_UPLOAD_BUDGET_MB=200
QUESTIONS_PER_CHUNK=5
PDF_MIN_CHARS_PER_PAGE=100  # below this → escalate to Docling

# --- Retrieval thresholds (optional; all default to today's values — a no-op).
#     Similarity distributions differ by subject/language; these are the tuning
#     surface. Set globally for now; per-subject profiles come later. ---
# RETRIEVAL_MATCH_MIN_SCORE=0.25   # min cosine to attempt grounding a question
# RETRIEVAL_CONFIDENT_MARGIN=0.03  # min best-vs-second margin for confident assignment
# RETRIEVAL_SEED_K=3               # chunks seeding each subtopic center
# RETRIEVAL_ITERS=2                # assignment refinement passes
# RETRIEVAL_ANN_CANDIDATES=5       # pgvector match_count per question

# --- Relative (self-calibrating) grounding gate (optional; OFF by default).
#     Changes WHICH questions get answered vs UNANSWERABLE — ships off. When on,
#     both absolute and relative decisions are logged for comparison. ---
# RETRIEVAL_RELATIVE_GATES=true    # accept by pool-relative standout, not fixed threshold
# RETRIEVAL_RELATIVE_K=1.5         # k robust-SD (MAD) above pool median
# RETRIEVAL_RELATIVE_RATIO=1.1     # min best/second-best ratio

# Local dev toggles (token-free, no cloud)
# DB_MODE=mock    # use in-memory DB instead of Supabase
# MOCK_AI=true    # return canned AI fixtures instead of calling Anthropic
