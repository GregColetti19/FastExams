# Deployment environment variables (Railway).
#
# Copy each block into the matching service's Variables tab and fill in real
# values. This file is COMMITTED — never put real keys in it.
#
# Local development uses .env.local instead; see .env.local.example, which
# carries the dev-only mock toggles and the full tuning surface. This file lists
# only what a deployment needs.
#
# Full walkthrough: DEPLOY.md


# ==============================================================
# SERVICE 1 — converter   (Root Directory: converter)
# ==============================================================

# Shared secret gating POST /convert. Must be byte-identical to CONVERTER_SECRET
# on the app service. Unset leaves the endpoint open — never do that on a
# service that is reachable.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONVERTER_SECRET=

# Railway injects PORT itself. Set it only if the dashboard shows no port for
# the service; the container binds to whatever PORT says, else 8001.
# PORT=8001


# ==============================================================
# SERVICE 2 — app   (Root Directory: empty / repo root)
# ==============================================================

# --- Supabase (Settings → API in the Supabase dashboard) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Bypasses row level security — must never be prefixed
# NEXT_PUBLIC_, which would ship it to every browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Internal auth ---
# Authenticates the detached server-to-server calls (upload → process-file,
# generate-exam → generate-questions/recalibrate). Those run after the response
# is sent and carry no session cookie, so middleware would otherwise reject
# them and every upload would stall at 'pending'. A DIFFERENT random value from
# CONVERTER_SECRET.
INTERNAL_API_SECRET=

# --- Converter ---
# Same value as SERVICE 1 above.
CONVERTER_SECRET=
# Private Railway hostname — http:// and the internal address on purpose, so
# conversion traffic never leaves the private network. Port comes from the
# converter service's dashboard.
CONVERTER_SERVICE_URL=http://converter.railway.internal:8001

# --- Upload limits ---
# 50MB is the Supabase FREE-TIER per-file storage cap. Setting these higher
# makes oversized files upload in full and then fail at storage with a 413.
# The two must match: the server enforces the first, the browser pre-checks the
# second, and the app warns at boot if they disagree.
MAX_FILE_SIZE_MB=50
NEXT_PUBLIC_MAX_FILE_SIZE_MB=50
# Per-user rolling-24h budget. ~4 uploads/day at the 50MB cap, bounding one
# account near $1.20/day at the measured ~$0.30/exam.
DAILY_UPLOAD_BUDGET_MB=200

# --- AI models (the stack chosen by measurement; see BACKLOG.md) ---
# ~$0.30/exam, 29x cheaper than sonnet-4.6 everywhere. Vendor-prefixed ids
# (containing '/') route to the OpenAI-compatible path automatically, so
# AI_PROVIDER is intentionally NOT set — forcing it would break per-task
# provider mixing.
#
# One key serves both chat and embeddings: the embed path falls back
# EMBED_API_KEY → OPEN_ROUTER_API_KEY → OPENAI_API_KEY.
OPEN_ROUTER_API_KEY=
AI_MODEL_DEFAULT=qwen/qwen3.7-flash
AI_MODEL_ANSWER_DETERMINATION=qwen/qwen3.7-plus
EMBED_MODEL_ID=qwen/qwen3-embedding-8b
EMBED_DIMENSIONS=1536
# Asymmetric embedding model: queries need this prefix, documents do not.
# Omitting it costs retrieval quality silently.
EMBED_QUERY_INSTRUCTION="Instruct: Given an exam question, retrieve the course material passage that answers it\nQuery: "
# Point embeddings at OpenRouter (default is api.openai.com, which does not
# serve the Qwen embedding model).
EMBED_BASE_URL=https://openrouter.ai/api/v1

# Only needed if you route any task to a bare 'claude-*' model id.
# ANTHROPIC_API_KEY=

# --- Processing ---
QUESTIONS_PER_CHUNK=5
PDF_MIN_CHARS_PER_PAGE=100  # below this, escalate the PDF to Docling


# ==============================================================
# Deliberately NOT set in a deployment
# ==============================================================
# DB_MODE=mock / NEXT_PUBLIC_DB_MODE=mock — in-memory dev store. In a
#   deployment this silently discards every tester's data on restart AND
#   disables the middleware auth gate.
# MOCK_AI=true — returns canned fixtures instead of calling a real model.
# SUPABASE_ACCESS_TOKEN / SUPABASE_DB_PASSWORD — CLI and direct-database
#   credentials. The running app never needs them; keep them off the service.
