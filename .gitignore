# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files — ignore everything except the committed .example templates.
# Deny-by-default: `.env*.local` alone missed files like `.env.alphaTest`, which
# held real deployment credentials.
.env
.env.*
!.env.example
!.env*.example
# Committed on purpose: local-dev defaults, mock flags only, no secrets.
!.env.development

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local mock DB
.dev-data/

# python converter
converter/venv/
__pycache__/
*.pyc

# converter test fixtures + artifacts (real exam PDFs kept local; large)
converter/input_test/
converter/output_test/
TestData/

# graphify knowledge-graph output (local tooling)
graphify-out/

# editor / local agent config
.vscode/
.claude/

# background task outputs
*.output

# supabase CLI local state
supabase/.temp/

# Model-eval artifacts: regenerable by scripts/model-grid/*.mjs and large
# (~84MB of embedding vectors, per-cell answers, converted corpora).
scripts/model-grid/data/
scripts/model-grid/results/
scripts/model-grid/results-*/
scripts/model-grid/gen-eval/data/
scripts/model-grid/gen-eval/results/
scripts/model-grid/gen-eval/results-*/
